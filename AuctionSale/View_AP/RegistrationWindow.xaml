<Window x:Class="View_AP.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View_AP"
        mc:Ignorable="d" FontSize="18"
        Title="REGISTRATION" Loaded="Window_Loaded" Height="450" Width="800" Top = "150" Left = "250">
   
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Label  Content="SIGN UP TO AUCTION"  FontSize="18" FontWeight="DemiBold" HorizontalAlignment="Center" Margin="0,0,0,40"/>
        <Label  Content="Username:"/>
        <TextBox Text="{Binding UserName, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged}" x:Name="nameTxtBox" MaxLength="50" Padding="0" Margin="0,0,0,10"/>
        <Label Content="Password:"/>
        <Grid>
            <Label Content="{Binding PasswordLength, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged}" Opacity="0" Height="30" Width="400" />
            <PasswordBox PasswordChanged="PasswordBox_PasswordChanged" x:Name="passwordPassBox" MaxLength="50" Margin="0,0,0,30" Height="30" Width="400"/>
        </Grid>
        <Button Command="{Binding SaveCommand}" x:Name="btnSignUp" Content="SIGN UP" HorizontalAlignment="Right"  VerticalAlignment="Center"/>
    </StackPanel>
</Window>
