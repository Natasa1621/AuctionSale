<Window x:Class="View_AP.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View_AP"
        mc:Ignorable="d" FontSize="18"
        Title="LOGIN" Loaded="Window_Loaded" Height="450" Width="800" Top = "150" Left = "250">
    <Window.Resources>
        <Style x:Key="InputBox">
            <Setter Property="Control.Height" Value="30"/>
            <Setter Property="Control.Width" Value="400"/>
        </Style>
    </Window.Resources>
    
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Label  Content="SIGN IN TO AUCTION"  FontSize="18" FontWeight="DemiBold" HorizontalAlignment="Center" Margin="0,0,0,40"/>
        <Label  Content="Username:"/>
        <TextBox x:Name="userNameTxtBox" Text="{Binding UserName, ValidatesOnNotifyDataErrors=False, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Style="{StaticResource InputBox}" Padding="0" Margin="0,0,0,10"/>
        <Label Content="Password:"/>
        <PasswordBox x:Name="passwordPassBox" PasswordChanged="PasswordBox_PasswordChanged" Style="{StaticResource InputBox}" Margin="0,0,0,30"/>
        <Button Command="{Binding LoginCommand}" x:Name="btnLogin" Content="SIGN IN" HorizontalAlignment="Right"  VerticalAlignment="Center" Width="105"/>
    </StackPanel>
</Window>
