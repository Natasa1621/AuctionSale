<Window x:Class="View_AP.SellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"       
        xmlns:local="clr-namespace:View_AP"
        xmlns:model="clr-namespace:Model_AP;assembly=Model_AP"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="650" Width="1400" Left="0"  Loaded="Window_Loaded" WindowStartupLocation="CenterScreen" FontSize="16">

    <Grid>
        <GroupBox Header="INFORMATION ABOUT THE PRODUCT" Margin="30,30,30,0">
            <StackPanel Margin="20">

                <Grid Margin="0, 10, 0, 0" Height="444" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="49*"/>
                        <RowDefinition Height="396*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,0,-30" Grid.RowSpan="2">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Product name:" HorizontalAlignment="Left" Margin="0,0,0,20" Width="120"/>
                            <TextBox Text="{Binding CurrentProduct.ProductName, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Margin="0,0,0,20" Width="700"></TextBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Start price:" HorizontalAlignment="Left"  Width="120" Margin="0,0,0,20"/>
                            <TextBox Text="{Binding CurrentProduct.StartingBid, StringFormat={}{0:N}, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=False, ValidatesOnDataErrors=False}" Margin="0,0,0,20" Width="Auto"></TextBox>
                        </StackPanel>
                        <Label Content="Product description:" HorizontalAlignment="Left" Margin="0,0,0,20"/>
                        <TextBox Text="{Binding CurrentProduct.Description, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" AcceptsReturn="True" Width="850" Height="293"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="30,0,30,0" Grid.RowSpan="2">
                        <Label Content="Product image:" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        <Border BorderBrush="Black" BorderThickness="1" CornerRadius="3" Height="320" Width="240" Margin="0,0" HorizontalAlignment="Left">
                            <Image x:Name="img"></Image>
                        </Border>
                        <Button Click="BtnBrowse_Click" HorizontalAlignment="Left" Width="240" Margin=" 0, 30,0,0">BROWSE</Button>
                    </StackPanel>
                </Grid>
                <Button Command="{Binding SaveCommand}"  Margin="0,0,0,0" HorizontalAlignment="Right">INSERT</Button>
            
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
